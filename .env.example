# ─────────────────────────────────────────────────────────────────────────────
# Voice Agent Observability Dashboard — environment configuration
# Copy to `.env` and fill in. Everything has a safe default so the app runs
# fully offline with zero external credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# SQLAlchemy URL. Defaults to a local SQLite file under backend/data/.
DATABASE_URL=sqlite:///./data/observability.db

# --- ElevenLabs webhook ---
# Shared secret used to verify the HMAC signature on post-call webhooks.
# Found in the ElevenLabs dashboard when you create the webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Set to false ONLY for local testing to accept unsigned webhook payloads.
ELEVENLABS_VERIFY_SIGNATURE=true
# Optional: API key to backfill conversations from the ElevenLabs REST API.
ELEVENLABS_API_KEY=

# --- Sentiment / task-completion judge ---
# If ANTHROPIC_API_KEY is set, Claude is used for sentiment + task judging.
# Otherwise a deterministic offline analyzer is used (no network required).
ANTHROPIC_API_KEY=
SENTIMENT_MODEL=claude-haiku-4-5-20251001

# --- Semantic transcript search (Chroma) ---
CHROMA_PERSIST_DIR=./data/chroma
# Embeddings: "hash" (offline, no deps) or "anthropic-free" style. Default offline.
EMBEDDINGS_BACKEND=hash

# --- SLO / alerting thresholds ---
SLO_LLM_TTFB_P95_MS=1500
SLO_SUCCESS_RATE_MIN=0.85
SLO_INTERRUPTION_RATE_MAX=0.25

# --- Cost model (USD) — mirrors ElevenLabs billing, override per your plan ---
COST_PER_CALL_MINUTE_USD=0.08
